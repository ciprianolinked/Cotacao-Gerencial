# ==============================================================================
# Gerencial · Mapa de Cotação — Variáveis de Ambiente
# Copie este arquivo para `.env` localmente ou cadastre na Vercel:
# Project Settings → Environment Variables
# ==============================================================================

# URL de conexão PostgreSQL (obrigatória).
# Na Vercel (Neon, Supabase, Vercel Postgres / Prisma Postgres), o sistema
# também reconhece automaticamente POSTGRES_URL, POSTGRES_PRISMA_URL ou
# POSTGRES_URL_NON_POOLING caso DATABASE_URL não esteja definida.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Chave gratuita do Google Gemini (opcional — também pode ser cadastrada pela
# interface em /configuracoes e salva no banco de dados).
# Obtenha gratuitamente em: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Modelo padrão do Google Gemini (opcional).
# O sistema alterna automaticamente entre gemini-4-hydrogen,
# gemini-3.5-flash-lite e demais modelos gratuitos caso haja 503/lentidão.
GEMINI_MODEL="gemini-4-hydrogen"
