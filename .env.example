# ---------------------------------------------------------------------------
# Gerencial · Governança Condominial — exemplo de variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores. NUNCA commite o `.env`.
# ---------------------------------------------------------------------------

# Conexão PostgreSQL (OBRIGATÓRIA).
# Na Vercel, configure a mesma variável no painel do projeto
# (Settings → Environment Variables), sem cometer o `.env` ao repositório.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ---------------------------------------------------------------------------
# Google Gemini (OPCIONAL) — IA gratuita para leitura de PDFs e fotos.
# Pode ser colada diretamente pelo painel "Configurar IA" ou via variável.
# Chave gratuita em: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""

# Modelo principal usado na leitura de propostas.
# Se falhar ou ficar lento, o sistema alterna automaticamente para os demais
# modelos gratuitos (ver `/ajuda/ia`).
GEMINI_MODEL="gemini-4-hydrogen"
